# ChannelOS IA — Environment Variables
# Copy to .env and fill in your keys

# LLM
ANTHROPIC_API_KEY=sk-ant-...

# Video rendering (JSON2Video — TTS + B-roll + subtitles)
JSON2VIDEO_API_KEY=...

# B-roll footage
PEXELS_API_KEY=...

# Trend research
TAVILY_API_KEY=tvly-...

# YouTube trend analysis
YOUTUBE_API_KEY=...

# PostgreSQL (Docker Compose default)
DATABASE_URL=postgresql://channelos:channelos@localhost:5432/channelos
